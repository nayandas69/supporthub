# ============================================
# DISCORD BOT CONFIGURATION
# ============================================

# Discord Bot Token from https://discord.com/developers/applications
# Go to: Bot section > Reset Token > Copy
DISCORD_TOKEN=your_bot_token_here

# Bot Client ID (Application ID)
# Go to: General Information > Application ID
CLIENT_ID=your_client_id_here

# ============================================
# SUPABASE DATABASE CONFIGURATION
# ============================================

# Supabase Project URL
# Format: https://xxxxxxxxxxxxx.supabase.co
# Found in: Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (REQUIRED - KEEP SECRET)
# Found in: Supabase Dashboard > Project Settings > API > Project API keys > service_role
# This key bypasses Row Level Security for bot operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Environment Mode (optional - defaults to "production")
# Options: development or production
NODE_ENV=production

# Health Check Server Port (optional - defaults to 3000)
# Railway/Render will auto-assign PORT, but you can override with this
PORT=3000

# ============================================
# UPTIME MONITORING
# ============================================

# Your deployed app URL for health checks
# Use this URL + /health endpoint in UptimeRobot/BetterUptime
# Example: https://supporthub-production.up.railway.app/health
# This keeps your Supabase connection alive 24/7 and prevents free tier sleep
# APP_URL=https://your-app.railway.app
